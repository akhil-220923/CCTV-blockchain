# =====================================================================
# Git Ignore Configuration for IBVAP (CCTV-Blockchain)
# =====================================================================

# Environment & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.local
.env.*.local
*.pem.bak
TUNNEL_URL.txt

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
backend/node_modules/
frontend/.output/
frontend/.wrangler/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
*.egg-info/
dist/
build/

# Heavy Model Files exceeding GitHub 100MB limit
# (Note: epoch_02.pt is tracked via split parts: ai_pipeline/epoch_02.pt.part_*)
ai_pipeline/epoch_02.pt
yolov8l.pt
yolov8m.pt
yolov8x.pt

# Debug / Temporary / Scratch files
debug_frame_*.jpg
debug_pedestrians_crop.jpg
scratch_frames/
test_blockchain_data/
*.log

# Windows / OS Metadata
*.Zone.Identifier
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~
