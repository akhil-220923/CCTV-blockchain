# =====================================================================
# Intelligent Border Video Analytics Platform (IBVAP) - Environment Config
# =====================================================================

# Server Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Service Networking & Inter-service URLs
API_BASE_URL=https://your-domain.com/api
FRONTEND_URL=http://frontend:3000
VITE_BACKEND_URL=http://backend:5000
CORS_ORIGIN=*

# AI Pipeline & Model Configuration
MODEL_PATH=ai_pipeline/epoch_02.pt
FALLBACK_MODEL=yolov8s.pt
CONFIDENCE_THRESHOLD=0.15

# Persistent Data Storage Paths
BLOCKCHAIN_DATA_PATH=blockchain_data
EVIDENCE_PATH=evidence
VIDEO_PATH=video

# Cloudflare Tunnel Configuration
DOMAIN_NAME=yourdomain.com
TUNNEL_NAME=ibvap-surveillance
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
